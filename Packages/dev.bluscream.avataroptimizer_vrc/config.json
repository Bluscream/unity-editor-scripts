{
  "$schema": "https://json.schemastore.org/json-schema.json",
  "version": "1.0.1",
  "shaderMapping": {
    "rules": [
      {
        "priority": 10,
        "description": "lilToon base shader — added in commit 6514f13 as part of the first comprehensive shader dump mapping pass; exact match avoids catching unrelated shaders that contain 'liltoon' in path.",
        "matchType": "Exact",
        "pattern": "lilToon",
        "targetShader": "VRChat/Mobile/Toon Standard",
        "caseSensitive": false,
        "requiredProperties": []
      },
      {
        "priority": 20,
        "description": "lilToon/lilToon category path — same pass as above; Unity stores the shader with a full category prefix path so both 'lilToon' and 'lilToon/lilToon' must be mapped independently.",
        "matchType": "Exact",
        "pattern": "lilToon/lilToon",
        "targetShader": "VRChat/Mobile/Toon Standard",
        "caseSensitive": false,
        "requiredProperties": []
      },
      {
        "priority": 30,
        "description": "Hidden/lilToonCutout — cutout alpha mode hidden variant used by lilToon for alphatest materials. Added in 6514f13; maps to Toon Standard (no translucency needed on Quest).",
        "matchType": "Exact",
        "pattern": "Hidden/lilToonCutout",
        "targetShader": "VRChat/Mobile/Toon Standard",
        "caseSensitive": false,
        "requiredProperties": []
      },
      {
        "priority": 40,
        "description": "Hidden/lilToonGem — lilToon's gem/crystal transparency shader uses refraction. Maps to Particles/Multiply for transparent glass-like appearance on Quest. Added in 6514f13.",
        "matchType": "Exact",
        "pattern": "Hidden/lilToonGem",
        "targetShader": "VRChat/Mobile/Particles/Multiply",
        "caseSensitive": false,
        "requiredProperties": []
      },
      {
        "priority": 50,
        "description": "Hidden/lilToonRefraction — lilToon refraction shader (glass, water, distortion). Maps to Particles/Multiply for transparency on Quest. Added in 6514f13.",
        "matchType": "Exact",
        "pattern": "Hidden/lilToonRefraction",
        "targetShader": "VRChat/Mobile/Particles/Multiply",
        "caseSensitive": false,
        "requiredProperties": []
      },
      {
        "priority": 60,
        "description": "Hidden/lilToonRefractionBlur — lilToon refraction with blur pass. Same reasoning as lilToonRefraction. Added in 6514f13.",
        "matchType": "Exact",
        "pattern": "Hidden/lilToonRefractionBlur",
        "targetShader": "VRChat/Mobile/Particles/Multiply",
        "caseSensitive": false,
        "requiredProperties": []
      },
      {
        "priority": 70,
        "description": "Hidden/lilToonLite — lightweight lilToon variant used for secondary/background meshes. Maps to Toon Standard. Added in 6514f13.",
        "matchType": "Exact",
        "pattern": "Hidden/lilToonLite",
        "targetShader": "VRChat/Mobile/Toon Standard",
        "caseSensitive": false,
        "requiredProperties": []
      },
      {
        "priority": 80,
        "description": "Hidden/lilToonLiteTransparent — transparent pass of lilToon Lite. Maps to Particles/Additive for see-through rendering on Quest. Added in 6514f13.",
        "matchType": "Exact",
        "pattern": "Hidden/lilToonLiteTransparent",
        "targetShader": "VRChat/Mobile/Particles/Additive",
        "caseSensitive": false,
        "requiredProperties": []
      },
      {
        "priority": 90,
        "description": "Hidden/lilToonTransparent — lilToon's transparent mode hidden pass. Maps to Particles/Additive for alpha transparency on Quest. Added in 6514f13.",
        "matchType": "Exact",
        "pattern": "Hidden/lilToonTransparent",
        "targetShader": "VRChat/Mobile/Particles/Additive",
        "caseSensitive": false,
        "requiredProperties": []
      },
      {
        "priority": 100,
        "description": "Property match on _RefractionMap — detects refraction/glass materials regardless of shader name (e.g. locked Poiyomi refraction with hashed name). Added when requiredProperties support was introduced in dfaee12 to survive shader locking obfuscation.",
        "matchType": "Contains",
        "pattern": "",
        "targetShader": "VRChat/Mobile/Particles/Multiply",
        "caseSensitive": false,
        "requiredProperties": ["_RefractionMap"]
      },
      {
        "priority": 110,
        "description": "Property match on _DissolveTex — detects dissolve-effect materials regardless of shader name (locked Poiyomi dissolve variants). Added in dfaee12 alongside _RefractionMap to handle name-obfuscated locked shader variants.",
        "matchType": "Contains",
        "pattern": "",
        "targetShader": "VRChat/Mobile/Toon Standard",
        "caseSensitive": false,
        "requiredProperties": ["_DissolveTex"]
      },
      {
        "priority": 120,
        "description": "Poiyomi particle subshaders — catches Poiyomi shaders that also expose _Particle property, e.g. Poiyomi particle/additive variants used for wings, sparkles, and glow effects. Added in 6514f13. Must come before the generic Poiyomi catch-all at priority 130.",
        "matchType": "Contains",
        "pattern": "poiyomi",
        "targetShader": "VRChat/Mobile/Particles/Additive",
        "caseSensitive": false,
        "requiredProperties": ["_Particle"]
      },
      {
        "priority": 130,
        "description": "Poiyomi catch-all — maps all remaining Poiyomi Pro/Toon/Locked variants to Toon Standard. Added as a fallback in commit 71f2580 specifically to handle Hidden/Locked/.poiyomi/... hashed variants that can't be matched by name. Must come after property-based Poiyomi rule at priority 120.",
        "matchType": "Contains",
        "pattern": "poiyomi",
        "targetShader": "VRChat/Mobile/Toon Standard",
        "caseSensitive": false,
        "requiredProperties": []
      },
      {
        "priority": 140,
        "description": "lilToon catch-all — catches any remaining lilToon variant paths not covered by exact rules (e.g. Hidden/lilToonFur, Hidden/lilToonOutline). Added in 6514f13 as a safety net after the specific exact rules at priorities 10-90.",
        "matchType": "Contains",
        "pattern": "lilToon",
        "targetShader": "VRChat/Mobile/Toon Standard",
        "caseSensitive": false,
        "requiredProperties": []
      },
      {
        "priority": 150,
        "description": "Eye and lens materials — fixed in commit 2d88f38 after user reported 'Mayu Lenses (Android) [Very Poor]' was incorrectly mapped to Diffuse instead of Multiply. Lens/eye meshes need transparency for the iris/pupil overlay effect to look correct on Quest.",
        "matchType": "Regex",
        "pattern": ".*(?:^|[\\W_])(?:lens|lenses|glass|eye|eyes)(?:[\\W_]|$).*",
        "targetShader": "VRChat/Mobile/Particles/Multiply",
        "caseSensitive": false,
        "requiredProperties": []
      },
      {
        "priority": 160,
        "description": "Transparent special-effect volumes — fixed across commits eb280a1/fc92cad/c67db47/3af5df5 after user tested each material: 'Fake_Volume 2' (flashlight cone needs transparency), visor/astral material, squishglass ('Dummy (Android) [Very Poor]'), PixelatePlane ('UnlitPixel'), and camera blocker visualizer all need Multiply for correct see-through rendering.",
        "matchType": "Regex",
        "pattern": ".*(?:^|[\\W_])(?:volume|cone|visor|censor|pixelate|squish)(?:[\\W_]|$).*",
        "targetShader": "VRChat/Mobile/Particles/Multiply",
        "caseSensitive": false,
        "requiredProperties": []
      },
      {
        "priority": 170,
        "description": "Generic transparent shaders — catch-all from commit 760849e for any shader whose name contains 'transparent' and hasn't matched an earlier specific rule. Maps to Additive as a safe default for unknown transparent modes.",
        "matchType": "Contains",
        "pattern": "transparent",
        "targetShader": "VRChat/Mobile/Particles/Additive",
        "caseSensitive": false,
        "requiredProperties": []
      }
    ]
  },
  "platformProfiles": [
    {
      "platform": "Android",
      "ranks": [
        { "name": "Excellent", "limits": { "MaxTriangles": 10000, "MaxMaterialSlots": 1, "MaxPhysBoneComponents": 0, "MaxPhysBoneTransforms": 0, "MaxPhysBoneColliders": 0, "MaxPhysBoneCollisionChecks": 0, "MaxTextureMemoryBytes": 10485760 } },
        { "name": "Good", "limits": { "MaxTriangles": 15000, "MaxMaterialSlots": 2, "MaxPhysBoneComponents": 1, "MaxPhysBoneTransforms": 16, "MaxPhysBoneColliders": 1, "MaxPhysBoneCollisionChecks": 16, "MaxTextureMemoryBytes": 15728640 } },
        { "name": "Medium", "limits": { "MaxTriangles": 20000, "MaxMaterialSlots": 4, "MaxPhysBoneComponents": 2, "MaxPhysBoneTransforms": 32, "MaxPhysBoneColliders": 2, "MaxPhysBoneCollisionChecks": 32, "MaxTextureMemoryBytes": 20971520 } },
        { "name": "Poor", "limits": { "MaxTriangles": 20000, "MaxMaterialSlots": 4, "MaxPhysBoneComponents": 8, "MaxPhysBoneTransforms": 64, "MaxPhysBoneColliders": 16, "MaxPhysBoneCollisionChecks": 64, "MaxTextureMemoryBytes": 41943040 } },
        { "name": "VeryPoor", "limits": { "MaxTriangles": 2147483647, "MaxMaterialSlots": 2147483647, "MaxPhysBoneComponents": 8, "MaxPhysBoneTransforms": 64, "MaxPhysBoneColliders": 16, "MaxPhysBoneCollisionChecks": 64, "MaxTextureMemoryBytes": 41943040 } }
      ]
    },
    {
      "platform": "iOS",
      "ranks": [
        { "name": "Excellent", "limits": { "MaxTriangles": 10000, "MaxMaterialSlots": 1, "MaxPhysBoneComponents": 0, "MaxPhysBoneTransforms": 0, "MaxPhysBoneColliders": 0, "MaxPhysBoneCollisionChecks": 0, "MaxTextureMemoryBytes": 10485760 } },
        { "name": "Good", "limits": { "MaxTriangles": 15000, "MaxMaterialSlots": 2, "MaxPhysBoneComponents": 1, "MaxPhysBoneTransforms": 16, "MaxPhysBoneColliders": 1, "MaxPhysBoneCollisionChecks": 16, "MaxTextureMemoryBytes": 15728640 } },
        { "name": "Medium", "limits": { "MaxTriangles": 20000, "MaxMaterialSlots": 4, "MaxPhysBoneComponents": 2, "MaxPhysBoneTransforms": 32, "MaxPhysBoneColliders": 2, "MaxPhysBoneCollisionChecks": 32, "MaxTextureMemoryBytes": 20971520 } },
        { "name": "Poor", "limits": { "MaxTriangles": 20000, "MaxMaterialSlots": 4, "MaxPhysBoneComponents": 8, "MaxPhysBoneTransforms": 64, "MaxPhysBoneColliders": 16, "MaxPhysBoneCollisionChecks": 64, "MaxTextureMemoryBytes": 41943040 } },
        { "name": "VeryPoor", "limits": { "MaxTriangles": 2147483647, "MaxMaterialSlots": 2147483647, "MaxPhysBoneComponents": 8, "MaxPhysBoneTransforms": 64, "MaxPhysBoneColliders": 16, "MaxPhysBoneCollisionChecks": 64, "MaxTextureMemoryBytes": 41943040 } }
      ]
    },
    {
      "platform": "PC",
      "ranks": [
        { "name": "Excellent", "limits": { "MaxTriangles": 32000, "MaxMaterialSlots": 4, "MaxPhysBoneComponents": 4, "MaxPhysBoneTransforms": 32, "MaxPhysBoneColliders": 4, "MaxPhysBoneCollisionChecks": 32, "MaxTextureMemoryBytes": 41943040 } },
        { "name": "Good", "limits": { "MaxTriangles": 70000, "MaxMaterialSlots": 8, "MaxPhysBoneComponents": 8, "MaxPhysBoneTransforms": 64, "MaxPhysBoneColliders": 8, "MaxPhysBoneCollisionChecks": 64, "MaxTextureMemoryBytes": 78643200 } },
        { "name": "Medium", "limits": { "MaxTriangles": 70000, "MaxMaterialSlots": 16, "MaxPhysBoneComponents": 16, "MaxPhysBoneTransforms": 128, "MaxPhysBoneColliders": 16, "MaxPhysBoneCollisionChecks": 128, "MaxTextureMemoryBytes": 157286400 } },
        { "name": "Poor", "limits": { "MaxTriangles": 70000, "MaxMaterialSlots": 32, "MaxPhysBoneComponents": 32, "MaxPhysBoneTransforms": 256, "MaxPhysBoneColliders": 32, "MaxPhysBoneCollisionChecks": 256, "MaxTextureMemoryBytes": 314572800 } },
        { "name": "VeryPoor", "limits": { "MaxTriangles": 2147483647, "MaxMaterialSlots": 2147483647, "MaxPhysBoneComponents": 2147483647, "MaxPhysBoneTransforms": 2147483647, "MaxPhysBoneColliders": 2147483647, "MaxPhysBoneCollisionChecks": 2147483647, "MaxTextureMemoryBytes": 2147483647 } }
      ]
    }
  ]
}
