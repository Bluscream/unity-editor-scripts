  "shaderMapping": {
    "rules": [
      {
        "caseSensitive": false,
        "description": "added in commit 6514f13 as part of the first comprehensive shader dump mapping pass; exact match avoids catching unrelated shaders that contain 'liltoon' in path.",
        "matchType": "Exact",
        "pattern": "lilToon",
        "priority": 10,
        "requiredProperties": [],
        "targetShader": "VRChat/Mobile/Toon Standard"
      },
      {
        "caseSensitive": false,
        "description": "same pass as above; Unity stores the shader with a full category prefix path so both 'lilToon' and 'lilToon/lilToon' must be mapped independently.",
        "matchType": "Exact",
        "pattern": "lilToon/lilToon",
        "priority": 20,
        "requiredProperties": [],
        "targetShader": "VRChat/Mobile/Toon Standard"
      },
      {
        "caseSensitive": false,
        "description": "cutout alpha mode hidden variant used by lilToon for alphatest materials. Added in 6514f13; maps to Toon Standard (no translucency needed on Quest).",
        "matchType": "Exact",
        "pattern": "Hidden/lilToonCutout",
        "priority": 30,
        "requiredProperties": [],
        "targetShader": "VRChat/Mobile/Toon Standard"
      },
      {
        "caseSensitive": false,
        "description": "lilToon's gem/crystal transparency shader uses refraction. Maps to Particles/Multiply for transparent glass-like appearance on Quest. Added in 6514f13.",
        "matchType": "Exact",
        "pattern": "Hidden/lilToonGem",
        "priority": 40,
        "requiredProperties": [],
        "targetShader": "VRChat/Mobile/Particles/Multiply"
      },
      {
        "caseSensitive": false,
        "description": "lilToon refraction shader (glass, water, distortion). Maps to Particles/Multiply for transparency on Quest. Added in 6514f13.",
        "matchType": "Exact",
        "pattern": "Hidden/lilToonRefraction",
        "priority": 50,
        "requiredProperties": [],
        "targetShader": "VRChat/Mobile/Particles/Multiply"
      },
      {
        "caseSensitive": false,
        "description": "lilToon refraction with blur pass. Same reasoning as lilToonRefraction. Added in 6514f13.",
        "matchType": "Exact",
        "pattern": "Hidden/lilToonRefractionBlur",
        "priority": 60,
        "requiredProperties": [],
        "targetShader": "VRChat/Mobile/Particles/Multiply"
      },
      {
        "caseSensitive": false,
        "description": "lightweight lilToon variant used for secondary/background meshes. Maps to Toon Standard. Added in 6514f13.",
        "matchType": "Exact",
        "pattern": "Hidden/lilToonLite",
        "priority": 70,
        "requiredProperties": [],
        "targetShader": "VRChat/Mobile/Toon Standard"
      },
      {
        "caseSensitive": false,
        "description": "transparent pass of lilToon Lite. Maps to Particles/Additive for see-through rendering on Quest. Added in 6514f13.",
        "matchType": "Exact",
        "pattern": "Hidden/lilToonLiteTransparent",
        "priority": 80,
        "requiredProperties": [],
        "targetShader": "VRChat/Mobile/Particles/Additive"
      },
      {
        "caseSensitive": false,
        "description": "lilToon's transparent mode hidden pass. Maps to Particles/Additive for alpha transparency on Quest. Added in 6514f13.",
        "matchType": "Exact",
        "pattern": "Hidden/lilToonTransparent",
        "priority": 90,
        "requiredProperties": [],
        "targetShader": "VRChat/Mobile/Particles/Additive"
      },
      {
        "caseSensitive": false,
        "description": "detects refraction/glass materials regardless of shader name (e.g. locked Poiyomi refraction with hashed name). Added when requiredProperties support was introduced in dfaee12 to survive shader locking obfuscation.",
        "matchType": "Contains",
        "pattern": "",
        "priority": 100,
        "requiredProperties": [
          "_RefractionMap"
        ],
        "targetShader": "VRChat/Mobile/Particles/Multiply"
      },
      {
        "caseSensitive": false,
        "description": "detects dissolve-effect materials regardless of shader name (locked Poiyomi dissolve variants). Added in dfaee12 alongside _RefractionMap to handle name-obfuscated locked shader variants.",
        "matchType": "Contains",
        "pattern": "",
        "priority": 110,
        "requiredProperties": [
          "_DissolveTex"
        ],
        "targetShader": "VRChat/Mobile/Toon Standard"
      },
      {
        "caseSensitive": false,
        "description": "catches Poiyomi shaders that also expose _Particle property, e.g. Poiyomi particle/additive variants used for wings, sparkles, and glow effects. Added in 6514f13. Must come before the generic Poiyomi catch-all at priority 130.",
        "matchType": "Contains",
        "pattern": "poiyomi",
        "priority": 120,
        "requiredProperties": [
          "_Particle"
        ],
        "targetShader": "VRChat/Mobile/Particles/Additive"
      },
      {
        "caseSensitive": false,
        "description": "maps all remaining Poiyomi Pro/Toon/Locked variants to Toon Standard. Added as a fallback in commit 71f2580 specifically to handle Hidden/Locked/.poiyomi/... hashed variants that can't be matched by name. Must come after property-based Poiyomi rule at priority 120.",
        "matchType": "Contains",
        "pattern": "poiyomi",
        "priority": 130,
        "requiredProperties": [],
        "targetShader": "VRChat/Mobile/Toon Standard"
      },
      {
        "caseSensitive": false,
        "description": "catches any remaining lilToon variant paths not covered by exact rules (e.g. Hidden/lilToonFur, Hidden/lilToonOutline). Added in 6514f13 as a safety net after the specific exact rules at priorities 10-90.",
        "matchType": "Contains",
        "pattern": "lilToon",
        "priority": 140,
        "requiredProperties": [],
        "targetShader": "VRChat/Mobile/Toon Standard"
      },
      {
        "caseSensitive": false,
        "description": "fixed in commit 2d88f38 after user reported 'Mayu Lenses (Android) [Very Poor]' was incorrectly mapped to Diffuse instead of Multiply. Lens/eye meshes need transparency for the iris/pupil overlay effect to look correct on Quest.",
        "matchType": "Regex",
        "pattern": ".*(?:^|[\\W_])(?:lens|lenses|glass|eye|eyes)(?:[\\W_]|$).*",
        "priority": 150,
        "requiredProperties": [],
        "targetShader": "VRChat/Mobile/Particles/Multiply"
      },
      {
        "caseSensitive": false,
        "description": "fixed across commits eb280a1/fc92cad/c67db47/3af5df5 after user tested each material: 'Fake_Volume 2' (flashlight cone needs transparency), visor/astral material, squishglass ('Dummy (Android) [Very Poor]'), PixelatePlane ('UnlitPixel'), and camera blocker visualizer all need Multiply for correct see-through rendering.",
        "matchType": "Regex",
        "pattern": ".*(?:^|[\\W_])(?:volume|cone|visor|censor|pixelate|squish)(?:[\\W_]|$).*",
        "priority": 160,
        "requiredProperties": [],
        "targetShader": "VRChat/Mobile/Particles/Multiply"
      },
      {
        "caseSensitive": false,
        "description": "catch-all from commit 760849e for any shader whose name contains 'transparent' and hasn't matched an earlier specific rule. Maps to Additive as a safe default for unknown transparent modes.",
        "matchType": "Contains",
        "pattern": "transparent",
        "priority": 170,
        "requiredProperties": [],
        "targetShader": "VRChat/Mobile/Particles/Additive"
      }
    ]
  },
  "version": "1.0.1"
